----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/path",
}
----
fn fail_lint(path : String, message : String) -> Unit raise {
  fail(path + ": " + message)
}

fn contains_unsafe_interpolation(line : String) -> Bool {
  line.contains("${{ github.event.") ||
  line.contains("${{ inputs.") ||
  line.contains("${{ github.head_ref") ||
  line.contains("${{ steps.")
}

fn check_run_blocks(path : String, lines : Array[String]) -> Unit raise {
  let mut in_run = false
  let mut run_indent = 0
  for i, raw in lines {
    let line = raw
    let trimmed = line.trim().to_owned()
    let indent = line.length() - line.trim_start().length()
    if in_run {
      if trimmed != "" && indent <= run_indent {
        in_run = false
      } else {
        if contains_unsafe_interpolation(line) {
          fail_lint(path, "line " + (i + 1).to_string() + ": unsafe template interpolation in run block; bind via env: first")
        }
        continue
      }
    }
    if trimmed.has_prefix("run:") || trimmed.has_prefix("- run:") {
      let after = match trimmed.find("run:") {
        Some(idx) => trimmed[idx + 4:].trim().to_owned()
        None => ""
      }
      if after == "|" || after == "|-" || after == ">" || after == ">-" || after == "" {
        in_run = true
        run_indent = indent
      } else if contains_unsafe_interpolation(after) {
        fail_lint(path, "line " + (i + 1).to_string() + ": unsafe inline run interpolation; bind via env: first")
      }
    }
  }
}

fn check_composite_action(path : String, text : String) -> Unit raise {
  let lines = text.replace_all(old="\r\n", new="\n").split("\n").map(x => x.to_owned()).collect()
  if !text.contains("using: composite") {
    fail_lint(path, "composite action must declare `using: composite`")
  }
  // Per-step check: every `run:` step inside `steps:` must have a `shell:` key
  let mut in_steps = false
  let mut step_indent = -1
  let mut step_has_run = false
  let mut step_has_shell = false
  for raw in lines {
    let trimmed = raw.trim().to_owned()
    let indent = raw.length() - raw.trim_start().length()
    if trimmed == "" || trimmed.has_prefix("#") {
      continue
    }
    if trimmed == "steps:" {
      in_steps = true
      step_indent = -1
      step_has_run = false
      step_has_shell = false
      continue
    }
    if !in_steps {
      continue
    }
    if trimmed.has_prefix("- ") && (step_indent == -1 || indent == step_indent) {
      if step_has_run && !step_has_shell {
        fail_lint(path, "composite step with `run:` is missing `shell:`")
      }
      step_indent = indent
      step_has_run = trimmed.has_prefix("- run:")
      step_has_shell = trimmed.has_prefix("- shell:")
      continue
    }
    if step_indent != -1 && indent > step_indent {
      if trimmed.has_prefix("run:") {
        step_has_run = true
      }
      if trimmed.has_prefix("shell:") {
        step_has_shell = true
      }
    }
  }
  if step_has_run && !step_has_shell {
    fail_lint(path, "composite step with `run:` is missing `shell:`")
  }
  if path != "setup/action.yml" && !text.contains("audit-event:") {
    fail_lint(path, "composite action must declare `audit-event` output")
  }
  check_run_blocks(path, lines)
}

fn check_workflow(path : String, text : String) -> Unit raise {
  let lines = text.replace_all(old="\r\n", new="\n").split("\n").map(x => x.to_owned()).collect()
  check_run_blocks(path, lines)
  if !text.contains("pull_request_target") {
    return
  }
  let mut in_jobs = false
  let mut job_name = ""
  let mut job_lines : Array[String] = []
  let jobs : Array[(String, Array[String])] = []
  for line in lines {
    let trimmed = line.trim().to_owned()
    let indent = line.length() - line.trim_start().length()
    if trimmed == "jobs:" && indent == 0 {
      in_jobs = true
      continue
    }
    if in_jobs && indent == 2 && trimmed.has_suffix(":") && !trimmed.has_prefix("#") {
      if job_name != "" {
        jobs.push((job_name, job_lines))
      }
      job_name = trimmed[:trimmed.length() - 1].to_owned()
      job_lines = []
      continue
    }
    if in_jobs && job_name != "" {
      job_lines.push(line)
    }
  }
  if job_name != "" {
    jobs.push((job_name, job_lines))
  }
  for pair in jobs {
    let (name, jlines) = pair
    let body = jlines.join("\n")
    let checks_out_pr = body.contains("pull_request.head") ||
      body.contains("refs/pull/")
    if checks_out_pr {
      if !body.contains("persist-credentials: false") {
        fail_lint(path, "job `" + name + "` checks out PR head under pull_request_target without `persist-credentials: false`")
      }
      if body.contains(": write") {
        fail_lint(path, "job `" + name + "` checks out PR head under pull_request_target and must not request write permissions")
      }
      let mut in_trusted_step = false
      for jline in jlines {
        let jt = jline.trim().to_owned()
        if jt.has_prefix("- ") {
          in_trusted_step = false
        }
        if jt == "working-directory: trusted" {
          in_trusted_step = true
        }
        if !in_trusted_step &&
          (
            jt.contains("moon build") ||
            jt.contains("moon test") ||
            jt.contains("npm install") ||
            jt.contains("pnpm install") ||
            jt.contains("cargo build")
          ) {
          fail_lint(path, "job `" + name + "` runs untrusted build/install command under pull_request_target: " + jt)
        }
      }
    }
  }
}

async fn collect_yaml_files(dir : String, out : Array[String]) -> Unit {
  if !@fs.exists(dir) {
    return
  }
  let entries = @fs.readdir(dir)
  entries.sort()
  for name in entries {
    if name.has_suffix(".yml") || name.has_suffix(".yaml") {
      out.push(dir + "/" + name)
    }
  }
}

async fn collect_markdown_files(dir : String, out : Array[String]) -> Unit {
  if !@fs.exists(dir) {
    return
  }
  let entries = @fs.readdir(dir)
  entries.sort()
  for name in entries {
    if name == "audit_report.md" {
      continue
    }
    let full = dir + "/" + name
    if @fs.kind(full) == @fs.Directory {
      collect_markdown_files(full, out)
    } else if name.has_suffix(".md") {
      out.push(full)
    }
  }
}

async fn check_markdown_links(path : String) -> Unit {
  let text = @fs.read_text(path).replace_all(old="\r\n", new="\n")
  let base_dir = @path.Path(path).dirname().to_string()
  let mut in_fence = false
  for raw in text.split("\n") {
    let line = raw.to_owned()
    if line.trim().has_prefix("```") {
      in_fence = !in_fence
      continue
    }
    if in_fence {
      continue
    }
    let chars = line.to_array()
    let mut i = 0
    while i < chars.length() {
      if chars[i] == ']' && i + 1 < chars.length() && chars[i + 1] == '(' {
        let start = i + 2
        let mut j = start
        while j < chars.length() && chars[j] != ')' {
          j += 1
        }
        if j < chars.length() {
          let raw_target = String::from_array(chars[start:j].to_owned()).trim().to_owned()
          let target = match raw_target.find("#") {
            Some(idx) => raw_target[:idx].to_owned()
            None => raw_target
          }
          if target != "" &&
            !target.has_prefix("http://") &&
            !target.has_prefix("https://") &&
            !target.has_prefix("mailto:") &&
            !target.has_prefix("file://") &&
            !target.contains("{") {
            let resolved = if base_dir == "" || base_dir == "." {
              target
            } else {
              @path.Path(base_dir).join(@path.Path(target)).normalize().to_string()
            }
            if !@fs.exists(resolved) {
              fail_lint(path, "broken relative link target: " + raw_target + " (resolved: " + resolved + ")")
            }
          }
          i = j + 1
          continue
        }
      }
      i += 1
    }
  }
}

async fn check_gitattributes() -> Unit {
  let path = ".gitattributes"
  if !@fs.exists(path) {
    fail_lint(
      path,
      "missing .gitattributes (must enforce eol=lf to prevent Windows CRLF CI failures)",
    )
  }
  let text = @fs.read_text(path).replace_all(old="\r\n", new="\n")
  let mut has_lf_rule = false
  for raw in text.split("\n") {
    let line = raw.trim().to_owned()
    if line == "" || line.has_prefix("#") {
      continue
    }
    if line.has_prefix("* ") && line.contains("eol=lf") {
      has_lf_rule = true
      break
    }
  }
  if !has_lf_rule {
    fail_lint(
      path,
      "must contain a `* ... eol=lf` rule to keep generated .mbti/.mbt files LF on Windows",
    )
  }
}

async fn main {
  check_gitattributes()

  let actions = [
    "action.yml",
    "setup/action.yml",
    "pr-check/action.yml",
    "pr-comment/action.yml",
  ]
  for path in actions {
    if !@fs.exists(path) {
      fail_lint(path, "missing composite action file")
    }
    check_composite_action(path, @fs.read_text(path))
  }

  let workflows : Array[String] = []
  collect_yaml_files(".github/workflows", workflows)
  collect_yaml_files("docs/examples/workflows", workflows)
  if workflows.is_empty() {
    fail_lint(".github/workflows", "no workflow YAML files discovered")
  }
  for path in workflows {
    check_workflow(path, @fs.read_text(path))
  }

  let docs : Array[String] = ["AGENTS.md"]
  collect_markdown_files("docs", docs)
  for doc in docs {
    check_markdown_links(doc)
  }

  println("Workflow, Action & Docs lint passed (" + actions.length().to_string() + " actions, " + workflows.length().to_string() + " workflows, " + docs.length().to_string() + " docs)")
}
