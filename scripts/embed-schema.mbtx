----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
}
----
async fn main {
  let source = @fs.read_text("docs/schema/config-v1.json")
  let lines = source.replace_all(old="\r\n", new="\n").trim().split("\n").map(line => "  #|" + line.to_owned()).collect()
  let generated = "// Generated by scripts/embed-schema.mbtx. Do not edit.\n\n///|\nlet config_schema_text : String =\n" + lines.join("\n") + "\n"
  let target = "engine/config_schema.mbt"
  if @env.args().contains("--check") {
    if @fs.read_text(target).replace_all(old="\r\n", new="\n") != generated { fail("Run moon run scripts/embed-schema.mbtx") }
  } else {
    @fs.write_text(target, generated)
  }
}
