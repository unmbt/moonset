----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----
fn extract_version(source : String) -> String raise {
  let normalized = source.replace_all(old="\r\n", new="\n")
  let mut brace_depth = 0
  for raw in normalized.split("\n") {
    let line = raw.trim().to_owned()
    if line == "" || line.has_prefix("//") {
      continue
    }
    if brace_depth == 0 && line.has_prefix("version") {
      let rest = line[7:].trim_start().to_owned()
      if rest.has_prefix("=") {
        let rhs = rest[1:].trim().to_owned()
        if rhs.has_prefix("\"") {
          let parsed = @json.parse(rhs)
          if parsed is String(v) && v != "" {
            return v
          }
        }
      }
    }
    for ch in line.to_array() {
      if ch == '{' {
        brace_depth += 1
      } else if ch == '}' && brace_depth > 0 {
        brace_depth -= 1
      }
    }
  }
  fail("Missing version field in moon.mod")
}

async fn main {
  let args = @env.args()
  let mut check_only = false
  let positional : Array[String] = []
  for i in 1..<args.length() {
    if args[i] == "--check" {
      check_only = true
    } else {
      positional.push(args[i])
    }
  }
  let (input_path, output_path) = match positional {
    [] => ("moon.mod", "cli/generated_version.mbt")
    [inp, out] => (inp, out)
    _ => fail("usage: gen-version.mbtx [--check] [<moon.mod> <output.mbt>]")
  }
  let source = @fs.read_text(input_path)
  let version = extract_version(source)
  let generated = "// Generated by scripts/gen-version.mbtx. Do not edit.\n\n///|\nconst VERSION : String = " +
    Json::string(version).stringify() +
    "\n"
  if check_only {
    if !@fs.exists(output_path) ||
      @fs.read_text(output_path).replace_all(old="\r\n", new="\n") != generated {
      fail("Run moon run scripts/gen-version.mbtx")
    }
  } else if !@fs.exists(output_path) ||
    @fs.read_text(output_path).replace_all(old="\r\n", new="\n") != generated {
    @fs.write_text(output_path, generated)
  }
}
