----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/path",
  "moonbitlang/core/json",
}
----
async fn write(root : String, path : String, text : String) -> Unit {
  let file = @path.Path(root).join(@path.Path(path)).to_string()
  @fs.mkdir(@path.Path(file).dirname().to_string(), recursive=true, allow_exist=true)
  @fs.write_text(file, text)
}

async fn git(root : String, args : Array[String]) -> String {
  let result = @shell.Cmd("git", args, cwd=root).output()
  if result.exit_code() != 0 { fail("git " + args.join(" ") + ": " + result.stderr()) }
  result.stdout().trim().to_owned()
}

async fn invoke(binary : String, root : String, args : Array[String], expected : Int) -> Json {
  let result = @shell.Cmd(binary, ["--cwd", root] + args).output()
  guard result.exit_code() == expected else {
    fail("Expected exit \{expected}, got \{result.exit_code()}: \{result.stderr()}\n\{result.stdout()}")
  }
  @json.parse(result.stdout())
}

async fn main {
  @shell.Cmd("moon", ["build", "--target", "native"]).run()
  let project = @env.current_dir().unwrap()
  let artifact = @path.Path(project).join(@path.Path("_build/native/debug/build/cmd/moonset/moonset")).to_string()
  let binary = if @fs.exists(artifact + ".exe") { artifact + ".exe" } else { artifact }
  let root = @fs.tmpdir(prefix="moonset-cli-")
  defer { @fs.rmdir(root, recursive=true) catch { _ => () } }
  ignore(git(root, ["init", "-b", "main"]))
  ignore(git(root, ["config", "user.name", "Moonset Tests"]))
  ignore(git(root, ["config", "user.email", "moonset@example.invalid"]))
  let manifest = "name = \"acme/app\"\nversion = \"0.1.0\"\n"
  write(root, "moon.mod", manifest)
  write(root, ".changeset/config.json", "{}")
  write(root, ".changeset/pending.md", "---\nacme/app: minor\n---\nExisting release")
  ignore(git(root, ["add", "."]))
  ignore(git(root, ["commit", "-m", "base"]))
  let base = git(root, ["rev-parse", "HEAD"])
  ignore(git(root, ["switch", "-c", "feature"]))
  write(root, "src/main.mbt", "// feature")
  ignore(git(root, ["add", "."]))
  ignore(git(root, ["commit", "-m", "code without changeset"]))
  let missing = invoke(binary, root, ["status", "--since", base, "--json"], 1)
  assert_true(missing is { "errors": [{ "code": "missing-changeset", .. }], .. })
  write(root, ".changeset/empty.md", "---\r\n---\r\nNo release required")
  ignore(git(root, ["add", "."]))
  ignore(git(root, ["commit", "-m", "empty changeset"]))
  let passing = invoke(binary, root, ["status", "--since", base, "--output", "json"], 0)
  assert_true(passing is { "hasRelease": False, "errors": [], "changesets": [{ "id": "empty", .. }], .. })
  ignore(git(root, ["mv", ".changeset/empty.md", ".changeset/renamed.md"]))
  ignore(git(root, ["commit", "-m", "rename changeset"]))
  ignore(git(root, ["switch", "main"]))
  write(root, "base-only.txt", "unrelated base branch change")
  ignore(git(root, ["add", "."]))
  ignore(git(root, ["commit", "-m", "base diverges"]))
  ignore(git(root, ["switch", "feature"]))
  write(root, "moon.mod", "invalid dirty manifest")
  let before = git(root, ["status", "--porcelain"])
  let head = invoke(binary, root, ["status", "--since", "main", "--json"], 0)
  assert_true(head is { "changesets": [{ "id": "renamed", .. }], "warnings": [{ "code": "uncommitted-excluded", .. }], .. })
  assert_eq(git(root, ["status", "--porcelain"]), before)
  let invalid_ref = invoke(binary, root, ["status", "--since", "missing-reference", "--json"], 3)
  assert_true(invalid_ref is { "errors": [{ "code": "external-error", .. }], .. })
  let invalid_input = invoke(binary, root, ["status", "--json"], 2)
  assert_true(invalid_input is { "errors": [{ "path": "moon.mod", .. }], .. })
  let output = @path.Path(root).join(@path.Path("plan.json")).to_string()
  ignore(invoke(binary, root, ["publish-plan", "--output", output], 2))
  assert_true(!@fs.exists(output))
  write(root, "moon.mod", manifest)
  let regular = invoke(binary, root, ["status", "--json"], 0)
  assert_true(regular is { "releases": [{ "newVersion": "0.2.0", .. }], .. })
  ignore(invoke(binary, root, ["publish-plan", "--output", "moon.mod"], 2))
  ignore(invoke(binary, root, ["publish-plan", "--output", "src/main.mbt"], 2))
  assert_eq(@fs.read_text(@path.Path(root).join(@path.Path("src/main.mbt")).to_string()), "// feature")
  assert_eq(@fs.read_text(@path.Path(root).join(@path.Path("moon.mod")).to_string()), manifest)
  let exported = @shell.Cmd(binary, ["--cwd", root, "publish-plan", "--output", output, "--pretty"]).output()
  if exported.exit_code() != 0 { fail("export: " + exported.stdout() + exported.stderr()) }
  assert_eq(exported.stdout(), "")
  assert_true(@json.parse(@fs.read_text(output)) is { "stage": "analysis", "executable": False, "schemaVersion": 1, .. })
  let replaced = @shell.Cmd(binary, ["--cwd", root, "publish-plan", "--output", output]).output()
  if replaced.exit_code() != 0 { fail(replaced.stderr()) }
  let first = invoke(binary, root, ["publish-plan"], 0)
  let second = invoke(binary, root, ["publish-plan"], 0)
  assert_eq(first, second)
  let generator_config : Json = {
    "changelog": { "generator": "fixture" },
    "plugins": {
      "generators": {
        "fixture": {
          "program": "node",
          "args": [@path.Path(project).join(@path.Path("fixtures/phase5-plugin.mjs")).to_string(), "success"],
          "allowedPrograms": ["node"],
          "environment": ["PATH", "SystemRoot"],
          "timeoutMs": 30000,
          "maxOutputBytes": 1048576,
        },
      },
    },
  }
  write(root, ".changeset/config.json", generator_config.stringify())
  let manifest_before = @fs.read_text(@path.Path(root).join(@path.Path("moon.mod")).to_string())
  let generated = invoke(binary, root, ["version", "--dry-run", "--json"], 0)
  assert_true(generated is {
    "changelogs": [{
      "generator": "fixture",
      "metadata": { "fixture": True, .. },
      "text": "phase5-fixture",
      ..
    }, ..],
    "fingerprint": String(_),
    ..
  })
  assert_eq(
    @fs.read_text(@path.Path(root).join(@path.Path("moon.mod")).to_string()),
    manifest_before,
  )
  assert_true(!@fs.exists(@path.Path(root).join(@path.Path(".moonset/release-state.json")).to_string()))
  let failing_config = generator_config.stringify().replace_all(old="\"success\"", new="\"crash\"")
  write(root, ".changeset/config.json", failing_config)
  let rejected = invoke(binary, root, ["version", "--json"], 2)
  assert_true(rejected is { "errors": [{ "code": "plugin-crashed", .. }, ..], .. })
  assert_eq(
    @fs.read_text(@path.Path(root).join(@path.Path("moon.mod")).to_string()),
    manifest_before,
  )
  assert_true(!@fs.exists(@path.Path(root).join(@path.Path(".moonset/release-state.json")).to_string()))

  // Full lifecycle integration: init -> add -> pre enter -> version -> pre exit -> version -> commit -> tag -> doctor
  let workflow_root = @fs.tmpdir(prefix="moonset-lifecycle-")
  defer { @fs.rmdir(workflow_root, recursive=true) catch { _ => () } }
  ignore(git(workflow_root, ["init", "-b", "main"]))
  ignore(git(workflow_root, ["config", "user.name", "Moonset Tests"]))
  ignore(git(workflow_root, ["config", "user.email", "moonset@example.invalid"]))
  write(workflow_root, "moon.mod", "name = \"acme/flow\"\nversion = \"0.1.0\"\n")
  let init_res = invoke(binary, workflow_root, ["init", "--json"], 0)
  assert_true(init_res is { "created": [_, ..], .. })
  let init_again = invoke(binary, workflow_root, ["init", "--json"], 0)
  assert_true(init_again is { "created": [], "skipped": [_, ..], .. })
  // Unknown package in add must fail
  ignore(invoke(binary, workflow_root, ["add", "--package", "acme/missing", "--type", "patch", "--summary", "bad", "--json"], 2))
  let added = invoke(binary, workflow_root, ["add", "--package", "acme/flow", "--type", "minor", "--summary", "Flow feature", "--id", "flow-feat", "--json"], 0)
  assert_true(added is { "id": "flow-feat", .. })
  let pre_enter = invoke(binary, workflow_root, ["pre", "enter", "alpha", "--initial-version", "--json"], 0)
  assert_true(pre_enter is { "mode": "active", "tag": "alpha", .. })
  // Duplicate pre enter must fail
  ignore(invoke(binary, workflow_root, ["pre", "enter", "beta", "--json"], 2))
  let v_pre = invoke(binary, workflow_root, ["version", "--json"], 0)
  assert_true(v_pre is { "analysis": { "releases": [{ "newVersion": "0.2.0-alpha.0", .. }], .. }, .. })
  assert_true(@fs.exists(@path.Path(workflow_root).join(@path.Path(".changeset/flow-feat.md")).to_string()))
  let pre_exit = invoke(binary, workflow_root, ["pre", "exit", "--json"], 0)
  assert_true(pre_exit is { "mode": "exit", .. })
  let v_grad = invoke(binary, workflow_root, ["version", "--json"], 0)
  assert_true(v_grad is { "analysis": { "releases": [{ "newVersion": "0.2.0", .. }], .. }, .. })
  assert_true(!@fs.exists(@path.Path(workflow_root).join(@path.Path(".changeset/pre.json")).to_string()))
  assert_true(!@fs.exists(@path.Path(workflow_root).join(@path.Path(".changeset/flow-feat.md")).to_string()))
  ignore(git(workflow_root, ["add", "."]))
  ignore(git(workflow_root, ["commit", "-m", "chore: release 0.2.0"]))
  let tagged = invoke(binary, workflow_root, ["tag", "--json"], 0)
  assert_true(tagged is { "created": ["v0.2.0"], "skipped": [], .. })
  let tagged_again = invoke(binary, workflow_root, ["tag", "--json"], 0)
  assert_true(tagged_again is { "created": [], "skipped": ["v0.2.0"], .. })
  let doc = invoke(binary, workflow_root, ["doctor", "--output", "json"], 0)
  assert_true(doc is { "ok": True, .. })

  // Verify non-status command JSON error envelope, exit code 1 for policy gate, doctor --fix, and commit.mode
  let pub_no_yes = invoke(binary, workflow_root, ["publish", "--json"], 1)
  assert_true(pub_no_yes is { "ok": False, "command": "publish", "errors": [{ "code": "confirmation-required", .. }], .. })

  let fix_root = @fs.tmpdir(prefix="moonset-docfix-")
  defer { @fs.rmdir(fix_root, recursive=true) catch { _ => () } }
  ignore(git(fix_root, ["init", "-b", "main"]))
  ignore(git(fix_root, ["config", "user.name", "Moonset Tests"]))
  ignore(git(fix_root, ["config", "user.email", "moonset@example.invalid"]))
  write(fix_root, "moon.mod", "name = \"acme/fix\"\nversion = \"0.1.0\"\n")
  let doc_fix = invoke(binary, fix_root, ["doctor", "--fix", "--json"], 1)
  assert_true(doc_fix is { "checks": [{ "name": "fix", "ok": True, .. }, ..], .. })
  assert_true(@fs.exists(@path.Path(fix_root).join(@path.Path(".changeset/config.json")).to_string()))
  write(fix_root, ".changeset/config.json", "{\"schemaVersion\":1,\"commit\":{\"mode\":\"both\",\"addMessage\":\"chore: add cs\",\"versionMessage\":\"chore: rel\"}}")
  ignore(git(fix_root, ["add", "."]))
  ignore(git(fix_root, ["commit", "-m", "init"]))
  ignore(invoke(binary, fix_root, ["add", "--package", "acme/fix", "--type", "patch", "--summary", "Auto committed fix", "--id", "auto-1", "--json"], 0))
  assert_eq(git(fix_root, ["log", "-n", "1", "--format=%s"]), "chore: add cs")
  ignore(invoke(binary, fix_root, ["version", "--json"], 0))
  assert_eq(git(fix_root, ["log", "-n", "1", "--format=%s"]), "chore: rel")
  println("CLI integration: Git snapshots, merge-base, rename, empty changesets, lifecycle, exits, JSON and no-write checks passed")
}
