///|
pub(all) struct DoctorCheck {
  name : String
  ok : Bool
  message : String
  suggestion : String?
}

///|
pub(all) struct DoctorReport {
  ok : Bool
  checks : Array[DoctorCheck]
}

///|
pub fn DoctorCheck::to_json(self : DoctorCheck) -> Json {
  {
    "name": self.name,
    "ok": self.ok,
    "message": self.message,
    "suggestion": match self.suggestion {
      Some(value) => Json::string(value)
      None => Json::null()
    },
  }
}

///|
pub fn DoctorReport::to_json(self : DoctorReport) -> Json {
  {
    "schemaVersion": 1,
    "ok": self.ok,
    "checks": self.checks.map(x => x.to_json()),
  }
}

///|
/// Default `.changeset/config.json` generated by `init` and `doctor --fix`.
pub fn default_config_template() -> String {
  "{\n  \"schemaVersion\": 1,\n  \"changelog\": { \"generator\": \"builtin\" },\n  \"access\": \"public\",\n  \"baseBranch\": \"main\",\n  \"commit\": { \"mode\": \"never\" },\n  \"formatter\": \"builtin\"\n}\n"
}

///|
/// Default `.changeset/README.md` generated by `init` and `doctor --fix`.
pub fn default_changeset_readme() -> String {
  "# Changesets\n\nRun `moonset add` to record a release.\n"
}

///|
/// Default `.moonset/.gitignore` generated by `init` and `doctor --fix`.
/// Note: `.changeset/pre.json` is intentionally NOT gitignored (Changesets v3 / ADR-009).
pub fn default_moonset_gitignore() -> String {
  "version-journal.json\npublish-state.json\npack-results.json\npack-results-*.json\npack/\n"
}

///|
/// Ensure initialization files exist (idempotent; never overwrites existing files).
pub async fn[H : ExecutionHost] ensure_init_files_with(
  host : H,
  cwd : String,
  config_path : String?,
) -> Array[String] {
  let fixed : Array[String] = []
  let cfg = match config_path {
    Some(custom) =>
      if @path.Path(custom).is_absolute() {
        custom
      } else {
        absolute_path(cwd, custom)
      }
    None => absolute_path(cwd, ".changeset/config.json")
  }
  let dir = parent_dir(cfg)
  if !host.exists(cfg) {
    host.mkdir(dir)
    host.write_text(cfg, default_config_template())
    fixed.push(cfg)
  }
  let readme = absolute_path(dir, "README.md")
  if !host.exists(readme) {
    host.mkdir(dir)
    host.write_text(readme, default_changeset_readme())
    fixed.push(readme)
  }
  let state_ignore = absolute_path(cwd, ".moonset/.gitignore")
  if !host.exists(state_ignore) {
    host.mkdir(parent_dir(state_ignore))
    host.write_text(state_ignore, default_moonset_gitignore())
    fixed.push(state_ignore)
  }
  fixed
}

///|
pub async fn[H : ExecutionHost] run_doctor_with(
  host : H,
  cwd : String,
  config_path? : String,
  loaded? : @workspace.LoadedWorkspace,
  check_registry~ : Bool = false,
  fix~ : Bool = false,
) -> DoctorReport {
  let checks : Array[DoctorCheck] = []
  if fix {
    let fixed_paths = ensure_init_files_with(host, cwd, config_path)
    checks.push({
      name: "fix",
      ok: true,
      message: if fixed_paths.is_empty() {
        "No missing initialization files needed repair"
      } else {
        "Initialized missing files: " + fixed_paths.join(", ")
      },
      suggestion: None,
    })
  }
  let git_ver = host.run("git", ["--version"], Some(cwd)) catch {
    error => { exit_code: 1, stdout: "", stderr: error_message(error), }
  }
  checks.push({
    name: "git",
    ok: git_ver.exit_code == 0,
    message: if git_ver.exit_code == 0 {
      git_ver.stdout.trim().to_owned()
    } else {
      "git is unavailable"
    },
    suggestion: if git_ver.exit_code == 0 {
      None
    } else {
      Some("Install Git and ensure it is on PATH")
    },
  })
  let moon_ver = host.run("moon", ["version"], Some(cwd)) catch {
    error => { exit_code: 1, stdout: "", stderr: error_message(error), }
  }
  checks.push({
    name: "moon",
    ok: moon_ver.exit_code == 0,
    message: if moon_ver.exit_code == 0 {
      moon_ver.stdout.trim().to_owned()
    } else {
      "moon toolchain is unavailable"
    },
    suggestion: if moon_ver.exit_code == 0 {
      None
    } else {
      Some("Install MoonBit toolchain and verify `moon version`")
    },
  })
  let discovered : Result[@workspace.LoadedWorkspace, Error] = match loaded {
    Some(preloaded) => Ok(preloaded)
    None =>
      Ok(@workspace.discover(cwd, config_path?, include_commits=false)) catch {
        error => Err(error)
      }
  }
  match discovered {
    Ok(loaded) => {
      checks.push({
        name: "workspace",
        ok: true,
        message: "Discovered " +
        loaded.snapshot.units.length().to_string() +
        " units",
        suggestion: None,
      })
      let journal = absolute_path(
        loaded.snapshot.root,
        ".moonset/version-journal.json",
      )
      let has_journal = host.exists(journal)
      checks.push({
        name: "journal",
        ok: !has_journal,
        message: if has_journal {
          "Unfinished version journal detected"
        } else {
          "No pending recovery journal"
        },
        suggestion: if has_journal {
          Some("Run `moonset version --recover` to restore incomplete edits")
        } else {
          None
        },
      })
      let dirty = host.run(
        "git",
        ["status", "--porcelain"],
        Some(loaded.snapshot.root),
      ) catch {
        _ => { exit_code: 1, stdout: "", stderr: "", }
      }
      let is_clean = dirty.exit_code == 0 &&
        !has_dirty_worktree_changes(dirty.stdout)
      checks.push({
        name: "git-worktree",
        ok: dirty.exit_code == 0 && is_clean,
        message: if dirty.exit_code != 0 {
          "Not inside a Git repository"
        } else if is_clean {
          "Working tree is clean"
        } else {
          "Working tree has uncommitted changes"
        },
        suggestion: if is_clean {
          None
        } else {
          Some("Commit or stash changes before running publish or tag")
        },
      })
      let resolved_fmt = detect_workspace_formatter_with(
        host,
        loaded.snapshot.root,
        loaded.snapshot.config,
      )
      if resolved_fmt != "builtin" && resolved_fmt != "none" {
        let fmt_program = resolve_formatter_program(
          host,
          loaded.snapshot.root,
          resolved_fmt,
        )
        let fmt_ver = host.run(
          fmt_program,
          ["--version"],
          Some(loaded.snapshot.root),
        ) catch {
          error =>
            if is_windows_host(host) &&
              !fmt_program.to_lower().has_suffix(".cmd") {
              host.run(
                fmt_program + ".cmd",
                ["--version"],
                Some(loaded.snapshot.root),
              ) catch {
                err2 =>
                  { exit_code: 1, stdout: "", stderr: error_message(err2), }
              }
            } else {
              { exit_code: 1, stdout: "", stderr: error_message(error), }
            }
        }
        checks.push({
          name: "formatter",
          ok: fmt_ver.exit_code == 0,
          message: if fmt_ver.exit_code == 0 {
            resolved_fmt + " " + fmt_ver.stdout.trim().to_owned()
          } else {
            "Configured formatter '" + resolved_fmt + "' is unavailable"
          },
          suggestion: if fmt_ver.exit_code == 0 {
            None
          } else {
            Some(
              "Install " +
              resolved_fmt +
              " on PATH or devDependencies, pass --no-format, or set formatter to builtin",
            )
          },
        })
      }
      if check_registry {
        let failures : Array[String] = []
        let checked_npm_managers : Map[String, Bool] = Map([])
        for unit in loaded.snapshot.units {
          if !unit.publish {
            continue
          }
          let unit_cwd = Some(absolute_path(loaded.snapshot.root, unit.root))
          match unit.ecosystem {
            @model.MoonBit => {
              let out = host.run("moon", ["publish", "--dry-run"], unit_cwd) catch {
                error =>
                  { exit_code: 1, stdout: "", stderr: error_message(error), }
              }
              if out.exit_code != 0 {
                failures.push(
                  "moon publish --dry-run failed for " +
                  unit.id +
                  ": " +
                  process_failure_detail(out),
                )
              }
            }
            @model.Npm => {
              let mgr = package_manager_program(
                host,
                manager_for_unit(loaded.snapshot, unit),
              )
              let reg_key = mgr +
                "@" +
                unit.publish_config.bind(pc => pc.registry).unwrap_or("default")
              if !checked_npm_managers.contains(reg_key) {
                checked_npm_managers[reg_key] = true
                let args = ["whoami"]
                if unit.publish_config is Some({ registry: Some(reg), .. }) {
                  args.push("--registry")
                  args.push(reg)
                }
                let out = host.run(mgr, args, unit_cwd) catch {
                  error =>
                    { exit_code: 1, stdout: "", stderr: error_message(error), }
                }
                if out.exit_code != 0 {
                  failures.push(
                    mgr +
                    " whoami failed for " +
                    unit.id +
                    ": " +
                    process_failure_detail(out),
                  )
                }
              }
            }
            @model.Cargo => {
              let out = host.run(
                "cargo",
                ["publish", "--dry-run", "--allow-dirty"],
                unit_cwd,
              ) catch {
                error =>
                  { exit_code: 1, stdout: "", stderr: error_message(error), }
              }
              if out.exit_code != 0 {
                failures.push(
                  "cargo publish --dry-run failed for " +
                  unit.id +
                  ": " +
                  process_failure_detail(out),
                )
              }
            }
          }
        }
        let reg_ok = failures.is_empty()
        checks.push({
          name: "registry",
          ok: reg_ok,
          message: if reg_ok {
            "Registry preflight checks passed"
          } else {
            failures.join("; ")
          },
          suggestion: if reg_ok {
            None
          } else {
            Some("Check registry login credentials and manifest metadata")
          },
        })
      }
      if host.getenv("GITHUB_ACTIONS") is Some("true") ||
        loaded.snapshot.config.publisher.token_env is Some(_) {
        let mut env_ok = true
        let missing_vars : Array[String] = []
        if host.getenv("GITHUB_ACTIONS") is Some("true") &&
          host.getenv("GITHUB_REPOSITORY").unwrap_or("") == "" {
          env_ok = false
          missing_vars.push("GITHUB_REPOSITORY")
        }
        if loaded.snapshot.config.publisher.token_env is Some(token_var) &&
          host.getenv(token_var).unwrap_or("") == "" {
          env_ok = false
          missing_vars.push(token_var)
        }
        checks.push({
          name: "ci-env",
          ok: env_ok,
          message: if env_ok {
            "Required CI/Action environment variables are present"
          } else {
            "Missing environment variables: " + missing_vars.join(", ")
          },
          suggestion: if env_ok {
            None
          } else {
            Some(
              "Configure the missing repository/token environment variables in CI",
            )
          },
        })
      }
    }
    Err(error) =>
      checks.push({
        name: "workspace",
        ok: false,
        message: error_message(error),
        suggestion: Some("Run `moonset init` or fix workspace/config errors"),
      })
  }
  { ok: checks.all(c => c.ok), checks, }
}

///|
pub async fn run_doctor(
  cwd : String,
  config_path? : String,
  check_registry~ : Bool = false,
  fix~ : Bool = false,
) -> DoctorReport {
  run_doctor_with(native_host(), cwd, config_path?, check_registry~, fix~)
}
