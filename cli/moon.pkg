import {
  "moonbitlang/core/json",
  "unmbt/moon-manifest" @manifest,
  "unmbt/moonset/model",
  "unmbt/moonset/engine",
  "unmbt/moonset/workspace",
  "unmbt/moonset/adapters",
  "unmbt/moonset/changelog",
  "unmbt/moonset/executor",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/path",
  "mizchi/tui",
  "mizchi/tui/render",
  "mizchi/tui/io",
}

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/stdio",
  ],
)

rule(
  name: "embed_moon_mod",
  command: ":embed -i $input -o $output --name embedded_moon_mod --text",
)

dev_build(
  rule: "embed_moon_mod",
  input: "../moon.mod",
  output: "embedded_version.mbt",
)
